# --- LLM provider ---
# "mock" runs entirely offline with MockLLMProvider (no key needed, used for
# tests and scripts/demo.py). Set to "openai" to use a real OpenAI-compatible
# endpoint.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- Deterministic interview rules ---
MIN_QUESTIONS=8
MIN_CURRICULUM_DAYS=4
MAX_QUESTIONS=12
MAX_FOLLOW_UPS_PER_TOPIC=2

# --- Database ---
DATABASE_URL=sqlite:///./interview.db

# --- Input limits ---
MAX_MESSAGE_LENGTH=4000

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
LOG_LEVEL=INFO
